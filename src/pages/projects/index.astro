---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Projects | Your Name" description="My software projects and work">
  <h1 class="text-3xl font-bold mb-8">Projects</h1>

  <div class="grid gap-6 md:grid-cols-2">
    {sortedProjects.map((project) => (
      <a
        href={`/projects/${project.slug}`}
        class="block p-6 border border-gray-200 dark:border-gray-800 rounded-lg hover:border-blue-500 dark:hover:border-blue-500 transition-colors"
      >
        {project.data.image && (
          <img
            src={project.data.image}
            alt={project.data.title}
            class="w-full h-40 object-cover rounded mb-4"
          />
        )}
        <h2 class="text-xl font-semibold mb-2">{project.data.title}</h2>
        <p class="text-gray-600 dark:text-gray-400 mb-4">
          {project.data.description}
        </p>
        <div class="flex flex-wrap gap-2">
          {project.data.tech.map((t) => (
            <span class="text-xs px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded">
              {t}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>

  {sortedProjects.length === 0 && (
    <p class="text-gray-600 dark:text-gray-400">No projects yet. Check back soon!</p>
  )}
</BaseLayout>
