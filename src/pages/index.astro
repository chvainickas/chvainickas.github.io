---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
}
---

<BaseLayout title="Home | Edward Chvainickas">
  <section class="mb-16">
    <h1 class="text-4xl font-bold mb-4">Hi, I'm Edward Chvainickas</h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 mb-6">
      Software developer and writer. I build things and write about technology.
    </p>
    <div class="flex gap-4">
      <a
        href="/projects"
        class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700"
      >
        View Projects
      </a>
      <a
        href="/about"
        class="px-4 py-2 border border-gray-300 dark:border-gray-700 rounded hover:bg-gray-100 dark:hover:bg-gray-800"
      >
        About Me
      </a>
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section class="mb-16">
      <h2 class="text-2xl font-bold mb-6">Featured Projects</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((project) => (
          <a
            href={`/projects/${project.slug}`}
            class="block p-6 border border-gray-200 dark:border-gray-800 rounded-lg hover:border-blue-500 dark:hover:border-blue-500 transition-colors"
          >
            <h3 class="text-lg font-semibold mb-2">{project.data.title}</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-3">
              {project.data.description}
            </p>
            <div class="flex flex-wrap gap-1">
              {project.data.tech.slice(0, 3).map((t) => (
                <span class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded">
                  {t}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
      <a href="/projects" class="inline-block mt-4 text-blue-600 dark:text-blue-400 hover:underline">
        View all projects &rarr;
      </a>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold mb-6">Recent Posts</h2>
      <div class="space-y-6">
        {recentPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="block p-6 border border-gray-200 dark:border-gray-800 rounded-lg hover:border-blue-500 dark:hover:border-blue-500 transition-colors"
          >
            <h3 class="text-lg font-semibold mb-1">{post.data.title}</h3>
            <p class="text-gray-600 dark:text-gray-400 text-sm mb-2">
              {post.data.description}
            </p>
            <time class="text-xs text-gray-500 dark:text-gray-500">
              {formatDate(post.data.date)}
            </time>
          </a>
        ))}
      </div>
      <a href="/blog" class="inline-block mt-4 text-blue-600 dark:text-blue-400 hover:underline">
        View all posts &rarr;
      </a>
    </section>
  )}
</BaseLayout>
