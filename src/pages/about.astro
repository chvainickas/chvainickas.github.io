---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Your Name" description="Learn more about me">
  <h1 class="text-3xl font-bold mb-8">About Me</h1>

  <div class="prose dark:prose-invert max-w-none">
    <p class="text-lg mb-6">
      Hello! I'm a software developer passionate about building useful things and sharing what I learn.
    </p>

    <h2>What I Do</h2>
    <p>
      I specialize in building web applications and writing about software development.
      My interests include [your interests here].
    </p>

    <h2>Skills</h2>
    <ul>
      <li>Languages: TypeScript, JavaScript, Python</li>
      <li>Frameworks: React, Node.js, Astro</li>
      <li>Tools: Git, Docker, Linux</li>
    </ul>

    <h2>Get in Touch</h2>
    <p>
      Feel free to reach out if you'd like to collaborate or just chat!
    </p>
    <ul>
      <li>Email: <a href="mailto:your@email.com">your@email.com</a></li>
      <li>GitHub: <a href="https://github.com/yourusername" target="_blank" rel="noopener noreferrer">@yourusername</a></li>
      <li>LinkedIn: <a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer">yourusername</a></li>
    </ul>
  </div>
</BaseLayout>
